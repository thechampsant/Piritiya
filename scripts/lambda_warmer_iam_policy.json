{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EventBridgeRule",
      "Effect": "Allow",
      "Action": [
        "events:PutRule",
        "events:PutTargets",
        "events:DescribeRule",
        "events:RemoveTargets",
        "events:ListTargetsByRule"
      ],
      "Resource": "arn:aws:events:us-east-1:288761728613:rule/piritiya-lambda-warmer"
    },
    {
      "Sid": "LambdaGetAndPermission",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:AddPermission"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:288761728613:function:get-soil-moisture",
        "arn:aws:lambda:us-east-1:288761728613:function:get-crop-advice",
        "arn:aws:lambda:us-east-1:288761728613:function:get-market-prices",
        "arn:aws:lambda:us-east-1:288761728613:function:get-govt-schemes"
      ]
    }
  ]
}
